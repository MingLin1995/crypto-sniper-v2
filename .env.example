# ========== 專案設定 ==========
APP_NAME=CryptoSniper V2
PROJECT_NAME=crypto-sniper-v2    # container name
PORT=3000              # Docker 內部 port
APP_PORT=3000          # 對外訪問 port (瀏覽器使用)
DEBUG_PORT=9229

# ========== 資料庫設定 ==========
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=dev_password
POSTGRES_DB=app_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/app_dev?schema=public

# ========== JWT 設定 ==========
# 產生強密碼指令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 密碼長度必須至少 32 字元，否則生產環境會拒絕啟動
JWT_SECRET=your-secret-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-in-production
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# ========== CORS 設定 ==========
# 啟用 CORS (true/false)
ENABLE_CORS=false
# 允許的來源 (多個用逗號分隔，例如: http://localhost:3000,https://example.com)
CORS_ORIGINS=http://localhost:3000

# ========== 前端與動態重導向設定 ==========
# 預設前端位址，登入後若無 dynamic origin 則重導向至此
FRONTEND_URL=http://localhost:3001

# ========== 日誌設定 ==========
# 是否記錄所有請求（開發環境可設為 true，生產環境建議 false）
LOG_ALL_REQUESTS=false

# ========== 預設管理員帳號設定 ==========
# 這些帳號會在首次初始化資料庫時建立
ADMIN_EMAIL_1=admin001@example.com
ADMIN_NICKNAME_1=admin001
ADMIN_PASSWORD_1=000000

ADMIN_EMAIL_2=admin002@example.com
ADMIN_NICKNAME_2=admin002
ADMIN_PASSWORD_2=000000

ADMIN_EMAIL_3=admin003@example.com
ADMIN_NICKNAME_3=admin003
ADMIN_PASSWORD_3=000000

# ========== Email 驗證 (SMTP) 設定 ==========
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ========== Google OAuth 設定 ==========
# 申請方式請參閱 docs/API_KEYS_SETUP.md
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ========== Discord OAuth 設定 ==========
# 申請方式請參閱 docs/API_KEYS_SETUP.md
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_CALLBACK_URL=http://localhost:3000/api/auth/discord/callback

# ========== Telegram Bot 設定 ==========
# 申請與設定 Webhook 方式請參閱 docs/API_KEYS_SETUP.md
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your-telegram-bot-username
TELEGRAM_WEBHOOK_URL=https://your-ngrok-or-domain.ngrok-free.dev

# ========== Web Push (VAPID) 設定 ==========
# 產生金鑰指令：npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:your-email@example.com

# ========== Redis & Cache 設定 ==========
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ========== CI/CD 部署 (GitHub Actions Secrets 參考，不需在本地啟用) ==========
# 這些變數應該設定在 GitHub 專案的 Settings -> Secrets and variables -> Actions 中
# AWS_ACCESS_KEY_ID=your-aws-access-key-id           # AWS IAM 使用者的 Access Key ID (需有 ECR 讀寫與上傳權限)
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key   # AWS IAM 使用者的 Secret Access Key
# AWS_REGION=ap-east-2                              # AWS 服務區域 (例如 ap-east-2)
# EC2_HOST=your-ec2-public-ip                       # 生產環境 EC2 的公網 IP 位址 (例如 43.213.20.134)
# EC2_USERNAME=ubuntu                               # EC2 登入帳號，預設 Ubuntu 映像檔為 ubuntu
# EC2_SSH_KEY=your-ssh-private-key-content          # 登入 EC2 的 SSH Private Key (.pem 檔案內容)

# ========== 生產環境 Docker Compose 參數化配置 (有預設值，選填) ==========
# 這些變數是在 EC2 主機部署時，寫在 EC2 端的 .env 中，讓 docker-compose.prod.yml 讀取的。
#
# 1. 鏡像來源 (AWS ECR)：請至 AWS ECR Console 建立 private repository 後取得網址
# API_IMAGE=your-aws-account-id.dkr.ecr.your-region.amazonaws.com/cryptosniper-api:latest
# WEB_IMAGE=your-aws-account-id.dkr.ecr.your-region.amazonaws.com/cryptosniper-web:latest
#
# 2. 網域路由設定 (Cloudflare/DNS)：請至 DNS 託管商 (如 Cloudflare) 設定 A 紀錄指向 EC2 的公網 IP
# APP_DOMAIN=crypto-sniper.yourdomain.com              # 前端 Web 應用主要存取網域 (例如 A 紀錄指向 your-ec2-public-ip)
# ROOT_DOMAIN=yourdomain.com                           # 根網域 (可選，用於重導向或併行路由)
# API_DOMAIN=api.crypto-sniper.yourdomain.com          # 後端 API 服務網域 (例如 A 紀錄指向 your-ec2-public-ip)
# MONITOR_DOMAIN=monitor.crypto-sniper.yourdomain.com  # Grafana 監控後台網域 (例如 A 紀錄指向 your-ec2-public-ip)
