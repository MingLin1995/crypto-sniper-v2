// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SystemConfig {
  key   String @id
  value String
}

model User {
  id         String   @id @default(uuid())
  nickname   String
  password   String?  // 第三方免密登入時，密碼可為空
  role       String   @default("USER") // USER, ADMIN
  email      String?  @unique

  // 第三方登入唯一 ID 綁定
  googleId   String?  @unique
  telegramId String?  @unique
  discordId  String?  @unique

  // 到價通知管道綁定
  telegramChatId String?
  discordWebhook String?

  refreshTokens    RefreshToken[]
  webSubscriptions WebSubscription[]
  watchlists       WatchlistItem[]
  savedStrategies  SavedStrategy[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // 軟刪除：NULL 表示未刪除，有值表示已刪除

  @@index([deletedAt]) // 加速查詢未刪除的用戶
  @@index([nickname, deletedAt])
  @@index([email, deletedAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   // Hashed Refresh Token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// 系統日誌
model SystemLog {
  id String @id @default(uuid())

  // 日誌等級
  level String // INFO, WARN, ERROR

  // 日誌類型（用於分類）
  type String // REQUEST, ERROR

  // 基本資訊
  message     String
  errorType   String? // 錯誤類型（如 UnauthorizedException）
  errorStack  String? @db.Text // Stack Trace

  // HTTP 請求資訊
  method     String? // GET, POST, PATCH, DELETE
  url        String? // 請求 URL
  statusCode Int? // HTTP 狀態碼
  duration   Int? // 執行時間（毫秒）

  // 請求內容
  requestBody   String? @db.Text
  requestParams String? @db.Text
  requestQuery  String? @db.Text

  // 客戶端資訊
  clientIp  String?
  userAgent String? @db.Text

  // 用戶資訊
  userId      String?
  userAccount String?

  // 額外資訊（彈性欄位）
  metadata Json? // 其他需要記錄的資訊

  createdAt DateTime @default(now())

  @@index([level])
  @@index([type])
  @@index([createdAt])
  @@index([userId])
  @@index([statusCode])
  @@index([level, createdAt])
}

// 瀏覽器 Web Push 訂閱資訊
model WebSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// IP 黑名單列表
model BlacklistedIp {
  id        String   @id @default(uuid())
  ip        String   @unique
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ip])
}

// 追蹤清單 / 我的最愛
model WatchlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  category  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, symbol])
  @@index([userId])
}

// 儲存策略
model SavedStrategy {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}
